# ==============================================================
# Tayar Intelligence Tools — Environment Configuration
# ==============================================================
# Copy this file to ".env" and fill in the values.
# All VITE_ prefixed vars are exposed to the browser.

# ---- App ----
VITE_APP_NAME="Tayar Intelligence Tools"
VITE_APP_URL="https://tayar.ai"
VITE_APP_ENV="production"

# ---- Supabase ----
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Service role key — server/edge functions only, NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DB_URL=""

# ---- AI Providers (edge function secrets, not exposed to browser) ----
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# ---- Email (edge function secrets) ----
EMAIL_FROM="noreply@tayar.ai"
EMAIL_FROM_NAME="Tayar Intelligence"
# SMTP or provider key if using a transactional email service
EMAIL_API_KEY=""

# ---- Monitoring / Analytics (VITE_ = browser-side) ----
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://app.posthog.com"
VITE_GA_MEASUREMENT_ID=""
VITE_SENTRY_DSN=""

# ---- Stripe (if payments enabled) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
VITE_STRIPE_PUBLISHABLE_KEY=""
