# Tayar Intelligence Tools — environment template
# Copy to .env for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Browser / Vite (VITE_* values are public in the client bundle)
# -----------------------------------------------------------------------------
VITE_APP_NAME="Tayar Intelligence Tools"
VITE_APP_URL="http://localhost:5173"
# Optional comma-separated browser origins in addition to APP_URL
ALLOWED_ORIGINS=""
VITE_PUBLIC_SITE_URL="http://localhost:5173"
VITE_APP_ENV="development"

VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_WEBSITE_GITHUB_CONNECTION_URL=""
VITE_WEBSITE_SUPABASE_CONNECTION_URL=""
VITE_WEBSITE_VERCEL_CONNECTION_URL=""
# Optional public HTTPS override for the Cloudflare R2 template domain.
# Production defaults to https://templates.tayar.se. Never put R2 credentials in VITE_* vars.
VITE_TEMPLATE_LIBRARY_BASE_URL=""

# Optional browser monitoring
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://app.posthog.com"
VITE_GA_MEASUREMENT_ID=""
VITE_SENTRY_DSN=""

# Optional client-side Stripe publishable key
VITE_STRIPE_PUBLISHABLE_KEY=""

# Optional public operator identity shown in Privacy Policy and Terms when configured.
VITE_LEGAL_ENTITY_NAME=""
VITE_LEGAL_REGISTRATION_NUMBER=""
VITE_LEGAL_POSTAL_ADDRESS=""
VITE_LEGAL_COUNTRY=""
VITE_LEGAL_CONTACT_EMAIL=""

# -----------------------------------------------------------------------------
# Supabase Edge Function secrets (set with `supabase secrets set`, not .env in prod)
# -----------------------------------------------------------------------------
APP_URL="http://localhost:5173"
# Optional comma-separated browser origins in addition to APP_URL
ALLOWED_ORIGINS=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""

# Vercel custom-domain management (server only; never use VITE_* names)
VERCEL_TOKEN=""
# Supplied automatically by Vercel deployments; set it explicitly elsewhere.
VERCEL_PROJECT_ID=""
# Optional override. Vercel deployments fall back to VERCEL_ORG_ID.
VERCEL_TEAM_ID=""
TAYAR_CANONICAL_ORIGIN="https://tayar.se"

# Unmounted customer-owned Publish deployment entry (server only).
# Configure in the deployment secret store; never add VITE_/NEXT_PUBLIC_ copies.
TAYAR_PLATFORM_SUPABASE_URL=""
TAYAR_PLATFORM_SUPABASE_SECRET_KEY=""
TAYAR_PLATFORM_ORIGIN=""
TAYAR_PLATFORM_SUPABASE_ORGANIZATION_ID=""
TAYAR_PLATFORM_VERCEL_ACCOUNT_ID=""
TAYAR_GITHUB_APP_CLIENT_ID=""
TAYAR_GITHUB_APP_PRIVATE_KEY_PKCS8=""

# Unpublished Vercel External Integration endpoint. Empty OAuth values keep
# only the authenticated disconnect path available.
WEBSITE_VERCEL_INTEGRATION_SLUG=""
WEBSITE_VERCEL_CLIENT_ID=""
WEBSITE_VERCEL_CLIENT_SECRET=""
WEBSITE_VERCEL_CALLBACK_URL=""
WEBSITE_VERCEL_RETURN_URL=""

# Unpublished Supabase OAuth endpoint. All values remain server-side.
WEBSITE_SUPABASE_OAUTH_CLIENT_ID=""
WEBSITE_SUPABASE_OAUTH_CLIENT_SECRET=""
WEBSITE_SUPABASE_PKCE_SECRET=""
WEBSITE_SUPABASE_CALLBACK_URL=""
WEBSITE_SUPABASE_RETURN_URL=""
WEBSITE_SUPABASE_PLATFORM_ORGANIZATION_ID=""

# Unpublished GitHub OAuth endpoint. All values remain server-side.
WEBSITE_GITHUB_APP_CLIENT_ID=""
WEBSITE_GITHUB_APP_CLIENT_SECRET=""
WEBSITE_GITHUB_CALLBACK_URL=""
WEBSITE_GITHUB_RETURN_URL=""

# AI providers currently used by ai-engine
GEMINI_API_KEY=""
FAL_KEY=""
# Server-side AI safety limits
AI_RATE_LIMIT_PER_MINUTE="30"
AI_MAX_REQUEST_CHARS="40000"
AI_MAX_BODY_CHARS="60000"
AI_MAX_OUTPUT_TOKENS="8192"

# Email service
EMAIL_API_KEY=""
WEBSITE_FORM_WEBHOOK_SECRET=""
EMAIL_FROM="noreply@example.com"
EMAIL_FROM_NAME="Tayar Intelligence"
SUPPORT_EMAIL="support@example.com"
# true only for local/dev testing; production should leave this false
EMAIL_DEV_MODE="false"

# Stripe subscriptions
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
