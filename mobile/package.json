{
  "name": "tayar-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "assets:android": "capacitor-assets generate --android --assetPath assets --iconBackgroundColor '#06060f' --splashBackgroundColor '#06060f'",
    "assets:ios": "capacitor-assets generate --ios --assetPath assets --iconBackgroundColor '#06060f' --splashBackgroundColor '#06060f'",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/device": "8.0.0",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/share": "8.0.0",
    "@capacitor/splash-screen": "8.0.0",
    "@capacitor/status-bar": "8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.0"
  }
}
