{
  "name": "tayar-intelligence-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "smoke:website-builder": "node scripts/website-builder-smoke-split-runner.mjs && node scripts/website-builder-ai-request-regression.mjs && node scripts/website-builder-ai-loader-regression.mjs && node scripts/website-builder-history-regression.mjs && node scripts/website-builder-snapshot-regression.mjs && node scripts/website-builder-ai-audit-regression.mjs",
    "smoke:website-builder:browser": "node scripts/website-builder-browser-regression-launcher.mjs",
    "launch:website-builder": "node scripts/website-builder-smoke-split-runner.mjs && node scripts/website-builder-launch.mjs",
    "smoke:site-polish": "node scripts/site-polish-smoke.mjs",
    "health:project": "npm run typecheck && npm run smoke:project-audit && npm run smoke:edge-functions && node scripts/project-health-refactor.mjs && npm run smoke:pdf-tools && npm run launch:website-builder && npm run smoke:published-runtime && npm run smoke:site-polish && npm run smoke:translator && npm run smoke:workspace-production && npm run smoke:i18n && npm run smoke:production && npm run smoke:mobile-store && npm run smoke:launch-pilot && npm run smoke:recovery-regression && npm run smoke:website-builder:design && npm run smoke:website-builder:cms && npm run smoke:website-builder:cms-transfer && npm run smoke:website-builder:cms-localization && npm run smoke:website-builder:cms-ai && npm run smoke:website-builder:templates && npm run smoke:website-builder:seo && npm run smoke:website-builder:forms && npm run smoke:website-builder:collaboration && npm run smoke:website-builder:integrations && npm run smoke:website-builder:reachability && npm run smoke:website-builder:application",
    "smoke:project-audit": "node scripts/project-audit-regression.mjs && node scripts/publishing-workflow-regression.mjs && node scripts/publish-archive-safety-regression.mjs && node scripts/admin-failure-recovery-regression.mjs",
    "smoke:edge-functions": "node scripts/edge-functions-syntax-smoke.mjs",
    "smoke:launch-pilot": "node scripts/launch-pilot-smoke.mjs",
    "smoke:translator": "node scripts/translator-smoke.mjs",
    "smoke:pdf-tools": "node scripts/pdf-tools-runtime-smoke.mjs",
    "smoke:i18n": "node scripts/i18n-coverage-smoke.mjs",
    "smoke:workspace-production": "node scripts/workspace-production-smoke.mjs",
    "smoke:production": "node scripts/production-hardening-smoke.mjs",
    "smoke:published-runtime": "node scripts/published-site-runtime-smoke.mjs",
    "smoke:mobile-store": "node scripts/mobile-store-readiness-smoke.mjs",
    "smoke:code-assistant": "node scripts/code-assistant-registry-smoke.mjs",
    "smoke:recovery-regression": "node scripts/recovery-regression-smoke.mjs",
    "health:code-assistant-registry": "node scripts/code-assistant-registry-health.mjs",
    "templates:r2:plan": "node scripts/template-library-r2-migrate.mjs",
    "templates:r2:migrate": "node scripts/template-library-r2-migrate.mjs --execute",
    "templates:supabase:purge:plan": "node scripts/template-library-supabase-purge.mjs",
    "templates:supabase:purge": "node scripts/template-library-supabase-purge.mjs --execute",
    "smoke:website-builder:design": "node scripts/website-builder-design-regression.mjs",
    "smoke:website-builder:cms": "node scripts/website-builder-cms-regression.mjs",
    "smoke:website-builder:cms-transfer": "node scripts/website-cms-transfer-smoke.mjs",
    "smoke:website-builder:cms-localization": "node scripts/website-cms-localization-regression.mjs && node scripts/website-unicode-slug-regression.mjs",
    "smoke:website-builder:cms-ai": "node scripts/website-cms-ai-regression.mjs",
    "smoke:website-builder:templates": "node scripts/website-builder-templates-regression.mjs",
    "smoke:website-builder:seo": "node scripts/website-builder-seo-quality-regression.mjs",
    "smoke:website-builder:forms": "node scripts/website-builder-forms-regression.mjs",
    "smoke:website-builder:collaboration": "node scripts/website-builder-collaboration-regression.mjs && node scripts/website-collaboration-regression.mjs",
    "smoke:website-builder:integrations": "node scripts/website-builder-integrations-regression.mjs",
    "smoke:website-builder:application": "node scripts/application-foundation-regression.mjs && node scripts/application-ai-regression.mjs",
    "smoke:website-builder:reachability": "node scripts/website-builder-max-reachability-regression.mjs"
  },
  "dependencies": {
    "@pdfme/pdf-lib": "^6.1.12",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "pdfjs-dist": "^5.4.149",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3"
  },
  "overrides": { "ws": "8.21.3" }
}
