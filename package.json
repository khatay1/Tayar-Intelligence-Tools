{
  "name": "tayar-intelligence-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "smoke:website-builder": "node scripts/website-builder-smoke.mjs",
    "launch:website-builder": "node scripts/website-builder-smoke.mjs && node scripts/website-builder-launch.mjs",
    "smoke:site-polish": "node scripts/site-polish-smoke.mjs",
    "health:project": "npm run typecheck && node scripts/project-health.mjs && npm run launch:website-builder && npm run smoke:site-polish && npm run smoke:translator && npm run smoke:workspace-production && npm run smoke:i18n && npm run smoke:production",
    "smoke:translator": "node scripts/translator-smoke.mjs",
    "smoke:i18n": "node scripts/i18n-coverage-smoke.mjs",
    "smoke:workspace-production": "node scripts/workspace-production-smoke.mjs",
    "smoke:production": "node scripts/production-hardening-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.2"
  },
  "overrides": {
    "ws": "8.21.3"
  }
}
